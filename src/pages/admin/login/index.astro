---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getDb } from "../../../lib/db";
import { isAuthenticated, needsSetup } from "../../../lib/auth";
import "../../../styles/admin.css";

export const prerender = false;

const db = getDb();

// Already signed in? Skip the form entirely.
if (await isAuthenticated(Astro.request, db)) {
  const target = Astro.url.searchParams.get("next");
  return Astro.redirect(target && target.startsWith("/") && !target.startsWith("//") ? target : "/admin/", 302);
}

const firstRun = await needsSetup(db);
---

<BaseLayout title="管理员登录 · 回声画廊" description="进入后台前的口令验证" noindex>
  <section class="wrap admin login-page">
    <div class="login-box">
      <p class="eyebrow">Admin</p>
      <h1>{firstRun ? "设置管理口令" : "管理员登录"}</h1>
      <p class="note">
        {
          firstRun
            ? "这是第一次进入后台，请设置一个口令。它会加密保存在服务器上，任何浏览器、任何设备都用同一个。"
            : "请输入管理口令。"
        }
      </p>

      <form id="login-form" data-first-run={String(firstRun)}>
        <label>
          口令
          <input
            type="password"
            id="login-pass"
            autocomplete={firstRun ? "new-password" : "current-password"}
            minlength="8"
            required
          />
        </label>
        {
          firstRun && (
            <label>
              再输入一次
              <input type="password" id="login-pass2" autocomplete="new-password" minlength="8" required />
            </label>
          )
        }
        <button type="submit" class="button" id="login-submit">{firstRun ? "设置并进入" : "进入后台"}</button>
        <p class="login-status" id="login-status"></p>
      </form>

      <p class="login-fineprint">
        口令经过 PBKDF2 加盐哈希后存放，登录状态是一个签名的 HttpOnly Cookie。
        服务器不保存明文口令，前端也拿不到任何可以直接改动网站的凭据。
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .login-page {
    display: flex;
    justify-content: center;
    padding-block: var(--space-6);
  }

  .login-box {
    width: min(420px, 100%);
    padding: var(--space-4);
    border: 1px solid var(--line);
    border-radius: 14px;
    background: var(--bg-raised);
  }

  .login-box h1 {
    font-size: 1.6rem;
    margin-block: var(--space-1) var(--space-2);
  }

  .login-box .note {
    margin-bottom: var(--space-3);
    font-size: 0.88rem;
  }

  .login-status {
    margin-top: var(--space-2);
    font-size: 0.8rem;
    color: #a4402f;
    min-height: 1.2em;
  }

  .login-fineprint {
    margin-top: var(--space-3);
    font-size: 0.74rem;
    line-height: 1.75;
    color: var(--ink-faint);
  }
</style>

<script>
  const form = document.getElementById("login-form") as HTMLFormElement;
  const passInput = document.getElementById("login-pass") as HTMLInputElement;
  const pass2Input = document.getElementById("login-pass2") as HTMLInputElement | null;
  const statusEl = document.getElementById("login-status")!;
  const submitBtn = document.getElementById("login-submit") as HTMLButtonElement;
  const firstRun = form.dataset.firstRun === "true";

  /** Only ever redirect back into this site's own admin area. */
  function safeNext(): string {
    const raw = new URLSearchParams(location.search).get("next");
    if (!raw || !raw.startsWith("/") || raw.startsWith("//")) return "/admin/";
    return raw;
  }

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    statusEl.textContent = "";

    const password = passInput.value;
    if (password.length < 8) {
      statusEl.textContent = "口令至少 8 个字符。";
      return;
    }
    if (firstRun && pass2Input && password !== pass2Input.value) {
      statusEl.textContent = "两次输入的口令不一致。";
      return;
    }

    submitBtn.disabled = true;
    try {
      const res = await fetch("/api/auth/login", {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify({ password }),
      });
      const data = (await res.json()) as { error?: string };
      if (!res.ok) {
        statusEl.textContent = data.error ?? `登录失败（${res.status}）`;
        passInput.value = "";
        passInput.focus();
        return;
      }
      location.replace(safeNext());
    } catch (err) {
      statusEl.textContent = `网络错误：${(err as Error).message}`;
    } finally {
      submitBtn.disabled = false;
    }
  });

  passInput.focus();
</script>
