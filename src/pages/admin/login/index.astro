---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import "../../../styles/admin.css";
---

<BaseLayout title="管理员登录 · 回声画廊" description="进入后台前的口令验证" noindex>
  <section class="wrap admin login-page">
    <div class="login-box">
      <p class="eyebrow">Admin</p>
      <h1 id="login-title">管理员登录</h1>
      <p class="note" id="login-note">请输入管理口令。</p>

      <form id="login-form">
        <label>
          口令
          <input type="password" id="login-pass" autocomplete="current-password" required />
        </label>
        <label id="login-confirm-wrap" hidden>
          再输入一次
          <input type="password" id="login-pass2" autocomplete="new-password" />
        </label>
        <button type="submit" class="button" id="login-submit">进入后台</button>
        <p class="login-status" id="login-status"></p>
      </form>

      <p class="login-fineprint">
        这道口令只是把后台界面藏起来，防止别人误入——它在浏览器里校验，懂技术的人可以绕过。
        真正的安全来自于：没有你的 GitHub 令牌，任何人都无法改动这个网站，而令牌只存在你自己的浏览器里。
      </p>
      <button type="button" class="login-reset" id="login-reset">
        忘记口令？重置（会同时清空本机保存的连接设置）
      </button>
    </div>
  </section>
</BaseLayout>

<style>
  .login-page {
    display: flex;
    justify-content: center;
    padding-block: var(--space-6);
  }

  .login-box {
    width: min(420px, 100%);
    padding: var(--space-4);
    border: 1px solid var(--line);
    border-radius: 14px;
    background: var(--bg-raised);
  }

  .login-box h1 {
    font-size: 1.6rem;
    margin-block: var(--space-1) var(--space-2);
  }

  .login-box .note {
    margin-bottom: var(--space-3);
    font-size: 0.88rem;
  }

  .login-status {
    margin-top: var(--space-2);
    font-size: 0.8rem;
    color: #a4402f;
    min-height: 1.2em;
  }

  .login-fineprint {
    margin-top: var(--space-3);
    font-size: 0.74rem;
    line-height: 1.75;
    color: var(--ink-faint);
  }

  .login-reset {
    margin-top: var(--space-2);
    background: none;
    border: 0;
    padding: 0;
    font-size: 0.72rem;
    color: var(--ink-faint);
    text-decoration: underline;
    cursor: pointer;
  }
</style>

<script>
  import { hasPassphrase, setPassphrase, verifyPassphrase, isUnlocked, unlock, resetAdmin } from "../../../lib/adminAuth";
  import { withBase } from "../../../lib/url";

  const form = document.getElementById("login-form") as HTMLFormElement;
  const passInput = document.getElementById("login-pass") as HTMLInputElement;
  const pass2Input = document.getElementById("login-pass2") as HTMLInputElement;
  const confirmWrap = document.getElementById("login-confirm-wrap")!;
  const statusEl = document.getElementById("login-status")!;
  const titleEl = document.getElementById("login-title")!;
  const noteEl = document.getElementById("login-note")!;
  const submitBtn = document.getElementById("login-submit")!;

  const adminHome = withBase("/admin/");

  /** Only allow redirecting back into this site's own admin area. */
  function safeNext(): string {
    const raw = new URLSearchParams(location.search).get("next");
    if (!raw) return adminHome;
    if (!raw.startsWith("/") || raw.startsWith("//")) return adminHome;
    return raw;
  }

  const firstRun = !hasPassphrase();

  if (firstRun) {
    titleEl.textContent = "设置管理口令";
    noteEl.textContent = "这是你第一次进入后台，请设置一个口令。它只保存在这台设备上。";
    confirmWrap.hidden = false;
    pass2Input.required = true;
    submitBtn.textContent = "设置并进入";
    passInput.autocomplete = "new-password";
  } else if (isUnlocked()) {
    location.replace(safeNext());
  }

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    statusEl.textContent = "";
    const pass = passInput.value;

    try {
      if (firstRun) {
        if (pass.length < 4) {
          statusEl.textContent = "口令太短了，至少 4 个字符。";
          return;
        }
        if (pass !== pass2Input.value) {
          statusEl.textContent = "两次输入的口令不一致。";
          return;
        }
        await setPassphrase(pass);
        unlock();
        location.replace(safeNext());
        return;
      }

      if (await verifyPassphrase(pass)) {
        unlock();
        location.replace(safeNext());
      } else {
        statusEl.textContent = "口令不正确。";
        passInput.value = "";
        passInput.focus();
      }
    } catch (err) {
      statusEl.textContent = `出错了：${(err as Error).message}`;
    }
  });

  document.getElementById("login-reset")?.addEventListener("click", () => {
    if (confirm("重置会清空本机保存的口令和 Cloudinary / GitHub 连接设置，确定吗？")) {
      resetAdmin();
      location.reload();
    }
  });

  passInput?.focus();
</script>
