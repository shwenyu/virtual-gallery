---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import AdminNav from "../../../components/AdminNav.astro";
import "../../../styles/admin.css";

export const prerender = false;
---

<BaseLayout title="系列管理 · 回声画廊" description="管理每个系列的名称、简介与照片顺序" noindex>
  <section class="wrap admin">
    <p class="eyebrow">Admin</p>
    <h1>系列管理</h1>
    <p class="note">编辑每个系列的标题、简介、排版风格、主题色，调整照片顺序，或新建 / 删除系列。</p>
    <AdminNav active="series" />

    <div class="toolbar">
      <span class="status" id="load-status">载入中…</span>
    </div>

    <div id="series-list"></div>

    <details class="panel">
      <summary>新建系列</summary>
      <form id="new-series-form">
        <div class="grid2">
          <label>Slug（网址用）<input type="text" id="ns-slug" placeholder="nightwalk" required /></label>
          <label>标题<input type="text" id="ns-title" placeholder="Nightwalk" required /></label>
          <label>副标题<input type="text" id="ns-subtitle" placeholder="夜行" /></label>
          <label>排版
            <select id="ns-layout">
              <option value="grid">grid</option>
              <option value="masonry">masonry</option>
              <option value="editorial">editorial</option>
              <option value="freeform">freeform</option>
              <option value="flow">flow</option>
            </select>
          </label>
        </div>
        <label>简介<textarea id="ns-description" rows="2"></textarea></label>
        <button type="submit" class="button">创建系列</button>
      </form>
    </details>

    <div class="panel log" id="log" hidden>
      <h2>执行日志</h2>
      <ol id="log-list"></ol>
    </div>
  </section>
</BaseLayout>

<script>
  interface Photo { id: string; src: string; alt: string }
  interface Series {
    slug: string; title: string; subtitle?: string; description?: string;
    layout: string; cover: string; photoIds: string[]; published?: boolean;
    flowDirection?: string; accentColor?: string; backgroundMode?: string;
    customBackground?: string; frameStyle?: string;
  }

  let allPhotos: Photo[] = [];

  function log(message: string, state: "info" | "ok" | "error" = "info") {
    const panel = document.getElementById("log")!;
    const list = document.getElementById("log-list")!;
    panel.hidden = false;
    const li = document.createElement("li");
    li.textContent = message;
    li.dataset.state = state;
    list.appendChild(li);
    li.scrollIntoView({ block: "nearest" });
  }

  const esc = (s: string) =>
    s.replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[c] ?? c);

  async function api(method: string, body: unknown) {
    const res = await fetch("/api/admin/series", {
      method,
      headers: { "content-type": "application/json" },
      body: JSON.stringify(body),
    });
    const data = (await res.json()) as { error?: string };
    if (!res.ok) throw new Error(data.error ?? `失败（${res.status}）`);
    return data;
  }

  function renderCard(entry: Series): HTMLElement {
    const published = entry.published !== false;
    const card = document.createElement("div");
    card.className = "series-card";
    card.dataset.slug = entry.slug;
    card.innerHTML = `
      <div class="series-card__header">
        <h2>${esc(entry.title || entry.slug)}</h2>
        <span class="publish-pill" data-published="${published}">${published ? "已发布" : "策展中（未发布）"}</span>
        <span class="series-card__slug">/gallery/${esc(entry.slug)}/</span>
      </div>
      <div class="grid2">
        <label>标题<input type="text" class="f-title" value="${esc(entry.title ?? "")}" /></label>
        <label>副标题<input type="text" class="f-subtitle" value="${esc(entry.subtitle ?? "")}" /></label>
        <label>排版
          <select class="f-layout">
            <option value="grid">grid（均匀网格）</option>
            <option value="masonry">masonry（瀑布流）</option>
            <option value="editorial">editorial（杂志式节奏）</option>
            <option value="freeform">freeform（自由拖拽）</option>
            <option value="flow">flow（沉浸式逐张浏览）</option>
          </select>
        </label>
        <label class="f-flow-wrap" hidden>flow 方向
          <select class="f-flow">
            <option value="horizontal">横向</option>
            <option value="vertical">纵向</option>
          </select>
        </label>
        <label>封面<select class="f-cover"></select></label>
      </div>
      <label>简介<textarea class="f-description" rows="2">${esc(entry.description ?? "")}</textarea></label>

      <p class="section-label">主题色彩</p>
      <div class="grid2">
        <label>核心色彩<input type="color" class="f-accent" value="${entry.accentColor ?? "#a4744f"}" /></label>
        <label>页面背景
          <select class="f-bg">
            <option value="site">跟随网站默认</option>
            <option value="accent">用核心色彩淡淡渲染</option>
            <option value="custom">自定义颜色</option>
          </select>
        </label>
        <label class="f-custombg-wrap" hidden>自定义背景色
          <input type="color" class="f-custombg" value="${entry.customBackground ?? "#f2f0eb"}" />
        </label>
        <label>照片边角
          <select class="f-frame"><option value="square">直角</option><option value="rounded">圆角</option></select>
        </label>
      </div>

      <p class="section-label">照片顺序</p>
      <ul class="photo-list"></ul>
      <div class="add-photo-row">
        <select class="add-select"></select>
        <button type="button" class="button button--secondary add-btn">加入</button>
      </div>

      <div class="series-card__actions">
        <button type="button" class="button save-btn">保存</button>
        <button type="button" class="button button--secondary publish-btn">${published ? "取消发布" : "发布"}</button>
        <a class="button button--secondary" href="/gallery/${esc(entry.slug)}/">查看页面</a>
        <button type="button" class="button button--danger delete-btn">删除系列</button>
        <span class="status card-status"></span>
      </div>
    `;

    const $ = <T extends Element>(sel: string) => card.querySelector(sel) as T;
    const layoutSel = $<HTMLSelectElement>(".f-layout");
    const flowWrap = $<HTMLElement>(".f-flow-wrap");
    const flowSel = $<HTMLSelectElement>(".f-flow");
    const bgSel = $<HTMLSelectElement>(".f-bg");
    const customBgWrap = $<HTMLElement>(".f-custombg-wrap");
    const frameSel = $<HTMLSelectElement>(".f-frame");
    const coverSel = $<HTMLSelectElement>(".f-cover");
    const addSel = $<HTMLSelectElement>(".add-select");
    const listEl = $<HTMLUListElement>(".photo-list");
    const status = $<HTMLElement>(".card-status");

    layoutSel.value = entry.layout;
    flowSel.value = entry.flowDirection ?? "horizontal";
    flowWrap.hidden = entry.layout !== "flow";
    layoutSel.addEventListener("change", () => (flowWrap.hidden = layoutSel.value !== "flow"));

    bgSel.value = entry.backgroundMode ?? "site";
    customBgWrap.hidden = bgSel.value !== "custom";
    bgSel.addEventListener("change", () => (customBgWrap.hidden = bgSel.value !== "custom"));
    frameSel.value = entry.frameStyle ?? "square";

    let photoIds = [...entry.photoIds];

    function refreshSelectors() {
      coverSel.innerHTML = photoIds.map((id) => `<option value="${esc(id)}">${esc(id)}</option>`).join("");
      coverSel.value = entry.cover;
      const remaining = allPhotos.filter((p) => !photoIds.includes(p.id));
      addSel.innerHTML = remaining
        .map((p) => `<option value="${esc(p.id)}">${esc(p.alt || p.id)}</option>`)
        .join("");
    }

    function renderPhotos() {
      listEl.innerHTML = "";
      photoIds.forEach((id, i) => {
        const photo = allPhotos.find((p) => p.id === id);
        const li = document.createElement("li");
        li.innerHTML = `
          ${photo ? `<img src="${esc(photo.src)}" alt="" />` : ""}
          <span class="photo-id">${esc(photo?.alt || id)}</span>
          <button type="button" data-a="up" ${i === 0 ? "disabled" : ""}>↑</button>
          <button type="button" data-a="down" ${i === photoIds.length - 1 ? "disabled" : ""}>↓</button>
          <button type="button" data-a="rm">移除</button>
        `;
        li.querySelector('[data-a="up"]')!.addEventListener("click", () => {
          [photoIds[i - 1], photoIds[i]] = [photoIds[i], photoIds[i - 1]];
          renderPhotos();
        });
        li.querySelector('[data-a="down"]')!.addEventListener("click", () => {
          [photoIds[i + 1], photoIds[i]] = [photoIds[i], photoIds[i + 1]];
          renderPhotos();
        });
        li.querySelector('[data-a="rm"]')!.addEventListener("click", () => {
          photoIds.splice(i, 1);
          renderPhotos();
        });
        listEl.appendChild(li);
      });
      refreshSelectors();
    }

    $<HTMLButtonElement>(".add-btn").addEventListener("click", () => {
      if (addSel.value && !photoIds.includes(addSel.value)) {
        photoIds.push(addSel.value);
        renderPhotos();
      }
    });

    renderPhotos();

    $<HTMLButtonElement>(".save-btn").addEventListener("click", async () => {
      status.textContent = "保存中…";
      try {
        await api("PATCH", {
          slug: entry.slug,
          title: $<HTMLInputElement>(".f-title").value,
          subtitle: $<HTMLInputElement>(".f-subtitle").value,
          description: $<HTMLTextAreaElement>(".f-description").value,
          layout: layoutSel.value,
          flowDirection: layoutSel.value === "flow" ? flowSel.value : null,
          cover: coverSel.value || photoIds[0] || "",
          accentColor: $<HTMLInputElement>(".f-accent").value,
          backgroundMode: bgSel.value,
          customBackground: bgSel.value === "custom" ? $<HTMLInputElement>(".f-custombg").value : null,
          frameStyle: frameSel.value,
          photoIds,
        });
        status.textContent = "已保存。";
        log(`已保存系列：${entry.slug}`, "ok");
      } catch (err) {
        status.textContent = `保存失败：${(err as Error).message}`;
      }
    });

    $<HTMLButtonElement>(".publish-btn").addEventListener("click", async (ev) => {
      const btn = ev.currentTarget as HTMLButtonElement;
      const pill = $<HTMLElement>(".publish-pill");
      const next = pill.dataset.published !== "true";
      btn.disabled = true;
      status.textContent = next ? "发布中…" : "取消发布中…";
      try {
        await api("PATCH", { slug: entry.slug, published: next });
        pill.dataset.published = String(next);
        pill.textContent = next ? "已发布" : "策展中（未发布）";
        btn.textContent = next ? "取消发布" : "发布";
        status.textContent = "已更新。";
        log(`${entry.slug} 现在是：${next ? "已发布" : "策展中"}`, "ok");
      } catch (err) {
        status.textContent = `操作失败：${(err as Error).message}`;
      } finally {
        btn.disabled = false;
      }
    });

    $<HTMLButtonElement>(".delete-btn").addEventListener("click", async () => {
      if (!confirm(`确定删除系列「${entry.title || entry.slug}」？照片本身不会被删除。`)) return;
      status.textContent = "删除中…";
      try {
        await api("DELETE", { slug: entry.slug });
        log(`已删除系列：${entry.slug}`, "ok");
        await load();
      } catch (err) {
        status.textContent = `删除失败：${(err as Error).message}`;
      }
    });

    return card;
  }

  async function load() {
    const status = document.getElementById("load-status")!;
    try {
      const [pRes, sRes] = await Promise.all([fetch("/api/admin/photos"), fetch("/api/admin/series")]);
      if (!pRes.ok || !sRes.ok) throw new Error("载入失败");
      allPhotos = ((await pRes.json()) as { photos: Photo[] }).photos;
      const { series } = (await sRes.json()) as { series: Series[] };
      const container = document.getElementById("series-list")!;
      container.innerHTML = "";
      for (const s of series) container.appendChild(renderCard(s));
      status.textContent = `${series.length} 个系列 · ${allPhotos.length} 张照片。`;
    } catch (err) {
      status.textContent = (err as Error).message;
    }
  }

  document.getElementById("new-series-form")!.addEventListener("submit", async (e) => {
    e.preventDefault();
    const form = e.currentTarget as HTMLFormElement;
    try {
      await api("POST", {
        slug: (document.getElementById("ns-slug") as HTMLInputElement).value,
        title: (document.getElementById("ns-title") as HTMLInputElement).value,
        subtitle: (document.getElementById("ns-subtitle") as HTMLInputElement).value,
        description: (document.getElementById("ns-description") as HTMLTextAreaElement).value,
        layout: (document.getElementById("ns-layout") as HTMLSelectElement).value,
      });
      log("已创建系列。", "ok");
      form.reset();
      await load();
    } catch (err) {
      log(`创建失败：${(err as Error).message}`, "error");
    }
  });

  load();
</script>
