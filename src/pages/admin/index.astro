---
import BaseLayout from "../../layouts/BaseLayout.astro";
import AdminNav from "../../components/AdminNav.astro";
import "../../styles/admin.css";

export const prerender = false;
---

<BaseLayout title="上传照片 · 回声画廊" description="上传照片到画廊" noindex>
  <section class="wrap admin">
    <p class="eyebrow">Admin</p>
    <h1>上传照片</h1>
    <p class="note">
      照片直接存进这个网站自己的存储里，信息写入数据库——不需要任何外部账号或令牌。
      可以分多次选择文件，每张都有预览、可单独移除。
    </p>
    <AdminNav active="upload" />

    <form class="panel" id="upload-form">
      <h2>选择照片</h2>
      <label>
        图片文件（可多选，支持 JPG / PNG / WebP / AVIF）
        <input type="file" id="files" accept="image/*" multiple />
      </label>
      <ul class="staged-list" id="staged-list"></ul>

      <div class="grid2">
        <label>
          归入系列
          <select id="series-select"><option value="">（暂不加入系列）</option></select>
        </label>
        <label>
          拍摄日期
          <input type="date" id="captured-at" />
        </label>
      </div>

      <label>
        统一说明文字（可留空；之后可在「照片管理」里逐张修改）
        <input type="text" id="caption" placeholder="例如：静" />
      </label>
      <label>
        标签（逗号分隔）
        <input type="text" id="tags" placeholder="landscape, quiet" />
      </label>

      <button type="submit" class="button" id="submit-btn">开始上传</button>
      <p class="note small">上传完成后立刻生效，不需要等待构建。</p>
    </form>

    <div class="panel log" id="log" hidden>
      <h2>执行日志</h2>
      <ol id="log-list"></ol>
    </div>
  </section>
</BaseLayout>

<script>
  const filesInput = document.getElementById("files") as HTMLInputElement;
  const stagedList = document.getElementById("staged-list")!;
  const seriesSelect = document.getElementById("series-select") as HTMLSelectElement;
  const submitBtn = document.getElementById("submit-btn") as HTMLButtonElement;

  interface Staged {
    file: File;
    url: string;
    width: number;
    height: number;
  }

  let staged: Staged[] = [];

  function log(message: string, state: "info" | "ok" | "error" = "info") {
    const panel = document.getElementById("log")!;
    const list = document.getElementById("log-list")!;
    panel.hidden = false;
    const li = document.createElement("li");
    li.textContent = message;
    li.dataset.state = state;
    list.appendChild(li);
    li.scrollIntoView({ block: "nearest" });
  }

  /** Reads the real pixel dimensions so the layout can reserve the right space. */
  function measure(file: File): Promise<Staged> {
    return new Promise((resolve, reject) => {
      const url = URL.createObjectURL(file);
      const img = new Image();
      img.onload = () => resolve({ file, url, width: img.naturalWidth, height: img.naturalHeight });
      img.onerror = () => {
        URL.revokeObjectURL(url);
        reject(new Error(`无法读取图片：${file.name}`));
      };
      img.src = url;
    });
  }

  function renderStaged() {
    stagedList.innerHTML = "";
    for (const item of staged) {
      const li = document.createElement("li");
      li.innerHTML = `
        <img src="${item.url}" alt="" />
        <span class="staged-name">${item.file.name}</span>
        <button type="button" class="staged-remove" aria-label="移除">&times;</button>
      `;
      li.querySelector(".staged-remove")!.addEventListener("click", () => {
        URL.revokeObjectURL(item.url);
        staged = staged.filter((s) => s !== item);
        renderStaged();
      });
      stagedList.appendChild(li);
    }
  }

  filesInput.addEventListener("change", async () => {
    const picked = Array.from(filesInput.files ?? []);
    // The native input replaces its FileList each time, so keep our own list and
    // reset the control — picking again then adds rather than replaces.
    filesInput.value = "";
    for (const file of picked) {
      const dupe = staged.some(
        (s) => s.file.name === file.name && s.file.size === file.size && s.file.lastModified === file.lastModified
      );
      if (dupe) continue;
      try {
        staged.push(await measure(file));
      } catch (err) {
        log((err as Error).message, "error");
      }
    }
    renderStaged();
  });

  async function loadSeries() {
    try {
      const res = await fetch("/api/admin/series");
      if (!res.ok) return;
      const { series } = (await res.json()) as { series: Array<{ slug: string; title: string }> };
      seriesSelect.innerHTML =
        '<option value="">（暂不加入系列）</option>' +
        series.map((s) => `<option value="${s.slug}">${s.title} (${s.slug})</option>`).join("");
    } catch {
      /* the select simply stays at its default */
    }
  }
  loadSeries();

  document.getElementById("upload-form")!.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (staged.length === 0) {
      log("请先选择至少一张图片。", "error");
      return;
    }

    const caption = (document.getElementById("caption") as HTMLInputElement).value.trim();
    const tags = (document.getElementById("tags") as HTMLInputElement).value.trim();
    const capturedAt = (document.getElementById("captured-at") as HTMLInputElement).value;
    const seriesSlug = seriesSelect.value;

    submitBtn.disabled = true;
    const succeeded: Staged[] = [];

    for (const item of staged) {
      try {
        log(`上传中：${item.file.name} …`);
        const form = new FormData();
        form.append("file", item.file);
        form.append("width", String(item.width));
        form.append("height", String(item.height));
        form.append("caption", caption);
        form.append("tags", tags);
        if (capturedAt) form.append("capturedAt", capturedAt);
        if (seriesSlug) form.append("seriesSlug", seriesSlug);

        const res = await fetch("/api/admin/upload", { method: "POST", body: form });
        const data = (await res.json()) as { error?: string; photo?: { id: string } };
        if (!res.ok) throw new Error(data.error ?? `上传失败（${res.status}）`);

        log(`已上传：${item.file.name} → ${data.photo!.id}`, "ok");
        succeeded.push(item);
      } catch (err) {
        // Keep failed files staged so they can be retried without re-picking.
        log(`失败：${item.file.name} — ${(err as Error).message}`, "error");
      }
    }

    for (const item of succeeded) URL.revokeObjectURL(item.url);
    staged = staged.filter((s) => !succeeded.includes(s));
    renderStaged();
    submitBtn.disabled = false;

    if (succeeded.length > 0) {
      log(`完成，共 ${succeeded.length} 张。刷新画廊即可看到。`, "ok");
    }
  });
</script>
