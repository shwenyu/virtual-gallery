---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import AdminNav from "../../../components/AdminNav.astro";
import "../../../styles/admin.css";

export const prerender = false;
---

<BaseLayout title="自由排版 · 回声画廊" description="直接在系列页面上拖拽编排照片" noindex>
  <section class="wrap admin">
    <p class="eyebrow">Admin</p>
    <h1>自由排版</h1>
    <p class="note">
      采用 <code>freeform</code> 排版的系列，可以直接在它自己的画廊页面上拖动照片、
      拉右下角改大小，改完就地保存——所见即所得。
    </p>
    <AdminNav active="layout" />

    <div class="toolbar"><span class="status" id="load-status">载入中…</span></div>
    <div id="freeform-list"></div>
  </section>
</BaseLayout>

<script>
  interface Series { slug: string; title: string; layout: string; photoIds: string[] }

  async function load() {
    const status = document.getElementById("load-status")!;
    const container = document.getElementById("freeform-list")!;
    try {
      const res = await fetch("/api/admin/series");
      if (!res.ok) throw new Error(`载入失败（${res.status}）`);
      const { series } = (await res.json()) as { series: Series[] };
      const freeform = series.filter((s) => s.layout === "freeform");
      container.innerHTML = "";
      if (freeform.length === 0) {
        status.textContent = "还没有 freeform 系列。去「系列管理」把某个系列的排版改成 freeform 即可。";
        return;
      }
      for (const s of freeform) {
        const card = document.createElement("div");
        card.className = "series-card";
        card.innerHTML = `
          <div class="series-card__header">
            <h2>${s.title || s.slug}</h2>
            <span class="series-card__slug">${s.photoIds.length} 张</span>
          </div>
          <div class="series-card__actions" style="border-top:0;padding-top:0;margin-top:0;">
            <a class="button" href="/gallery/${s.slug}/?edit=1">打开并编辑排版</a>
          </div>
        `;
        container.appendChild(card);
      }
      status.textContent = `${freeform.length} 个 freeform 系列。`;
    } catch (err) {
      status.textContent = (err as Error).message;
    }
  }

  load();
</script>
