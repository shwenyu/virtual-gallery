---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import AdminNav from "../../../components/AdminNav.astro";
import "../../../styles/admin.css";

export const prerender = false;
---

<BaseLayout title="照片管理 · 回声画廊" description="修改每一张照片的名称与说明文字" noindex>
  <section class="wrap admin">
    <p class="eyebrow">Admin</p>
    <h1>照片管理</h1>
    <p class="note">
      上传时填的是统一说明文字，方便批量处理；这里可以逐张修改名称（alt，用于无障碍朗读）、
      说明文字（画廊里显示的文字）和标签。
    </p>
    <AdminNav active="photos" />

    <div class="toolbar">
      <input type="search" id="filter-input" placeholder="按 id / 名称 / 说明 / 标签搜索…" style="flex:1;min-width:200px;" />
      <span class="status" id="load-status">载入中…</span>
    </div>

    <div id="photo-list" class="photo-grid"></div>

    <div class="panel log" id="log" hidden>
      <h2>执行日志</h2>
      <ol id="log-list"></ol>
    </div>
  </section>
</BaseLayout>

<script>
  interface Photo {
    id: string;
    src: string;
    width: number;
    height: number;
    alt: string;
    caption?: string;
    capturedAt?: string;
    tags?: string[];
  }

  let allPhotos: Photo[] = [];

  function log(message: string, state: "info" | "ok" | "error" = "info") {
    const panel = document.getElementById("log")!;
    const list = document.getElementById("log-list")!;
    panel.hidden = false;
    const li = document.createElement("li");
    li.textContent = message;
    li.dataset.state = state;
    list.appendChild(li);
    li.scrollIntoView({ block: "nearest" });
  }

  const esc = (s: string) =>
    s.replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[c] ?? c);

  function renderCard(photo: Photo): HTMLElement {
    const card = document.createElement("div");
    card.className = "photo-card";
    card.dataset.id = photo.id;
    card.innerHTML = `
      <img src="${esc(photo.src)}" alt="" loading="lazy" />
      <div class="photo-card__fields">
        <span class="photo-card__id">${esc(photo.id)} · ${photo.width}×${photo.height}</span>
        <input type="text" class="f-alt" placeholder="名称" value="${esc(photo.alt ?? "")}" />
        <input type="text" class="f-caption" placeholder="说明文字" value="${esc(photo.caption ?? "")}" />
        <input type="text" class="f-tags" placeholder="标签，逗号分隔" value="${esc((photo.tags ?? []).join(", "))}" />
        <div class="photo-card__actions">
          <button type="button" class="button button--small save-btn">保存</button>
          <button type="button" class="button button--small button--danger delete-btn">删除</button>
          <span class="status card-status"></span>
        </div>
      </div>
    `;

    const status = card.querySelector(".card-status") as HTMLElement;

    card.querySelector(".save-btn")!.addEventListener("click", async () => {
      status.textContent = "保存中…";
      try {
        const res = await fetch("/api/admin/photos", {
          method: "PATCH",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({
            id: photo.id,
            alt: (card.querySelector(".f-alt") as HTMLInputElement).value,
            caption: (card.querySelector(".f-caption") as HTMLInputElement).value,
            tags: (card.querySelector(".f-tags") as HTMLInputElement).value,
            capturedAt: photo.capturedAt ?? "",
          }),
        });
        const data = (await res.json()) as { error?: string };
        if (!res.ok) throw new Error(data.error ?? `失败（${res.status}）`);
        status.textContent = "已保存。";
        log(`已保存：${photo.id}`, "ok");
      } catch (err) {
        status.textContent = `保存失败：${(err as Error).message}`;
      }
    });

    card.querySelector(".delete-btn")!.addEventListener("click", async () => {
      if (!confirm(`确定删除照片 ${photo.id}？会同时从所有系列里移除，且原图一并删除，无法撤销。`)) return;
      status.textContent = "删除中…";
      try {
        const res = await fetch("/api/admin/photos", {
          method: "DELETE",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({ id: photo.id }),
        });
        const data = (await res.json()) as { error?: string };
        if (!res.ok) throw new Error(data.error ?? `失败（${res.status}）`);
        allPhotos = allPhotos.filter((p) => p.id !== photo.id);
        card.remove();
        document.getElementById("load-status")!.textContent = `${allPhotos.length} 张照片。`;
        log(`已删除：${photo.id}`, "ok");
      } catch (err) {
        status.textContent = `删除失败：${(err as Error).message}`;
      }
    });

    return card;
  }

  function renderList(photos: Photo[]) {
    const container = document.getElementById("photo-list")!;
    container.innerHTML = "";
    for (const p of photos) container.appendChild(renderCard(p));
  }

  async function load() {
    const status = document.getElementById("load-status")!;
    try {
      const res = await fetch("/api/admin/photos");
      if (!res.ok) throw new Error(`载入失败（${res.status}）`);
      const { photos } = (await res.json()) as { photos: Photo[] };
      allPhotos = photos;
      renderList(allPhotos);
      status.textContent = `${photos.length} 张照片。`;
    } catch (err) {
      status.textContent = (err as Error).message;
    }
  }

  document.getElementById("filter-input")!.addEventListener("input", (e) => {
    const q = (e.target as HTMLInputElement).value.trim().toLowerCase();
    renderList(
      q
        ? allPhotos.filter((p) =>
            [p.id, p.alt, p.caption, ...(p.tags ?? [])].filter(Boolean).join(" ").toLowerCase().includes(q)
          )
        : allPhotos
    );
  });

  load();
</script>
