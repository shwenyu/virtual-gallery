---
// Guards an admin page: if the session isn't unlocked, redirect to the login
// page and never reveal the content. See src/lib/adminAuth.ts for why this is a
// deterrent rather than real security.
---

<div id="admin-content" hidden>
  <slot />
</div>

<style>
  /* An author `display` rule would override the `hidden` attribute, so keep this
     explicit: hidden must win regardless of what else targets this element. */
  #admin-content[hidden] {
    display: none !important;
  }
</style>

<script>
  import { isUnlocked } from "../lib/adminAuth";
  import { withBase } from "../lib/url";

  const content = document.getElementById("admin-content")!;

  if (isUnlocked()) {
    content.hidden = false;
    window.dispatchEvent(new CustomEvent("admin-unlocked"));
  } else {
    const next = location.pathname + location.search;
    location.replace(`${withBase("/admin/login/")}?next=${encodeURIComponent(next)}`);
  }
</script>
